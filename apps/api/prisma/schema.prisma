// Prisma schema for AI Job Agent Israel.
// Initial data foundation: users, resumes, career profiles, jobs, matches.
// Vector/embedding columns are introduced in the matching-engine milestone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// Enums
// --------------------------------------------------------------------------

enum UserRole {
  CANDIDATE
  ADMIN
}

enum LanguageCode {
  HE
  EN
}

enum ResumeFileType {
  PDF
  DOCX
  DOC
  TXT
}

enum ResumeStatus {
  UPLOADED
  PARSING
  PARSED
  FAILED
}

enum SeniorityLevel {
  STUDENT
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
}

enum WorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
}

enum JobStatus {
  ACTIVE
  CLOSED
  ARCHIVED
  DUPLICATE
}

enum MatchStatus {
  NEW
  VIEWED
  SAVED
  APPLIED
  DISMISSED
}

enum AuditAction {
  USER_REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  TOKEN_REFRESHED
  LOGOUT
}

// --------------------------------------------------------------------------
// Models
// --------------------------------------------------------------------------

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String
  role         UserRole     @default(CANDIDATE)
  displayName  String?
  locale       LanguageCode @default(HE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  resumes       Resume[]
  careerProfile CareerProfile?
  matches       JobMatch[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Resume {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName   String
  fileType   ResumeFileType
  storageKey String         @unique
  fileSize   Int
  checksum   String
  status     ResumeStatus   @default(UPLOADED)
  language   LanguageCode?
  rawText    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  careerProfile CareerProfile?

  @@index([userId])
  @@map("resumes")
}

model CareerProfile {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @unique @db.Uuid
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceResumeId String?         @unique @db.Uuid
  sourceResume   Resume?         @relation(fields: [sourceResumeId], references: [id], onDelete: SetNull)

  headline           String?
  summary            String?
  yearsExperience    Float?
  seniority          SeniorityLevel?
  desiredRoles       String[]
  skills             String[]
  technologies       String[]
  industries         String[]
  preferredLocations String[]
  workArrangements   WorkArrangement[]
  desiredSalaryMin   Int?
  desiredSalaryMax   Int?
  salaryCurrency     String            @default("ILS")

  // Rich, flexible structures kept as JSON (languages, education, experience,
  // certifications, projects, soft skills, and the full extraction payload).
  languages      Json?
  education      Json?
  experience     Json?
  certifications Json?
  projects       Json?
  data           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("career_profiles")
}

model Job {
  id              String           @id @default(uuid()) @db.Uuid
  source          String
  externalId      String?
  sourceUrl       String?
  title           String
  company         String
  description     String
  location        String?
  city            String?
  isRemote        Boolean          @default(false)
  workArrangement WorkArrangement?
  employmentType  EmploymentType?
  seniority       SeniorityLevel?
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String           @default("ILS")
  language        LanguageCode?
  skills          String[]
  technologies    String[]
  postedAt        DateTime?
  status          JobStatus        @default(ACTIVE)
  // Deduplication & freshness tracking (populated at ingestion).
  // dedupeKey groups the same posting seen across multiple sources;
  // contentHash detects changes to a posting's content. When a posting is a
  // cross-source duplicate its status is DUPLICATE and canonicalId points at
  // the kept (canonical) job.
  dedupeKey       String?
  contentHash     String?
  canonicalId     String?          @db.Uuid
  firstSeenAt     DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  matches JobMatch[]

  @@unique([source, externalId])
  @@index([status])
  @@index([city])
  @@index([dedupeKey])
  @@map("jobs")
}

model JobMatch {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String      @db.Uuid
  job          Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  overallScore Float
  // Per-dimension scores with explanations (experience, skills, technology,
  // industry, culture, growth, salary, location, remote, progression,
  // learning, interview probability, confidence).
  scores       Json
  status       MatchStatus @default(NEW)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([jobId])
  @@map("job_matches")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 hash of the opaque refresh token; the raw value is never stored.
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @db.Uuid
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
