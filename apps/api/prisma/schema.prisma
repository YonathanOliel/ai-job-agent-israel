// Prisma schema for AI Job Agent Israel.
// Initial data foundation: users, resumes, career profiles, jobs, matches.
// Vector/embedding columns power the semantic matching engine (pgvector).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// Enums
// --------------------------------------------------------------------------

enum UserRole {
  CANDIDATE
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

/// Role of a user within an organization (tenant-scoped, independent of the
/// platform-wide UserRole).
enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum LanguageCode {
  HE
  EN
}

enum ResumeFileType {
  PDF
  DOCX
  DOC
  TXT
}

enum ResumeStatus {
  UPLOADED
  PARSING
  PARSED
  FAILED
}

enum SeniorityLevel {
  STUDENT
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
}

enum WorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
}

enum JobStatus {
  ACTIVE
  CLOSED
  ARCHIVED
  DUPLICATE
}

enum SourceRunStatus {
  PENDING
  SUCCESS
  FAILED
}

enum MatchStatus {
  NEW
  VIEWED
  SAVED
  APPLIED
  DISMISSED
}

enum AuditAction {
  USER_REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  TOKEN_REFRESHED
  LOGOUT
}

// --------------------------------------------------------------------------
// Models
// --------------------------------------------------------------------------

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String
  role         UserRole     @default(CANDIDATE)
  displayName  String?
  locale       LanguageCode @default(HE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  resumes       Resume[]
  careerProfile CareerProfile?
  matches       JobMatch[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  orgMemberships OrganizationMembership[]

  @@map("users")
}

/// A tenant. Customer data (recruiters, saved searches, talent lists) is scoped
/// to an organization; the job market dataset itself is shared across tenants.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  plan      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMembership[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(MEMBER)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

/// Monthly metered usage per organization (talent searches, API calls, …).
/// Enforced against the org's plan limits from the plan catalog.
model UsageRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  metric         String
  period         String
  count          Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, metric, period])
  @@index([organizationId, period])
  @@map("usage_records")
}

model Resume {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName   String
  fileType   ResumeFileType
  storageKey String         @unique
  fileSize   Int
  checksum   String
  status     ResumeStatus   @default(UPLOADED)
  language   LanguageCode?
  rawText    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  careerProfile CareerProfile?

  @@index([userId])
  @@map("resumes")
}

model CareerProfile {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @unique @db.Uuid
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceResumeId String?         @unique @db.Uuid
  sourceResume   Resume?         @relation(fields: [sourceResumeId], references: [id], onDelete: SetNull)

  headline           String?
  summary            String?
  yearsExperience    Float?
  seniority          SeniorityLevel?
  desiredRoles       String[]
  skills             String[]
  technologies       String[]
  industries         String[]
  preferredLocations String[]
  workArrangements   WorkArrangement[]
  desiredSalaryMin   Int?
  desiredSalaryMax   Int?
  salaryCurrency     String            @default("ILS")

  // Rich, flexible structures kept as JSON (languages, education, experience,
  // certifications, projects, soft skills, and the full extraction payload).
  languages      Json?
  education      Json?
  experience     Json?
  certifications Json?
  projects       Json?
  data           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Semantic embedding for AI matching (pgvector, cosine similarity).
  /// Populated best-effort by EmbeddingService; null until computed or when
  /// embeddings are disabled (no OPENAI_API_KEY). Prisma Client does not
  /// expose Unsupported columns — read/write via raw SQL only.
  embedding Unsupported("vector(1536)")?

  @@map("career_profiles")
}

model Job {
  id              String           @id @default(uuid()) @db.Uuid
  source          String
  externalId      String?
  sourceUrl       String?
  title           String
  company         String
  description     String
  location        String?
  city            String?
  isRemote        Boolean          @default(false)
  workArrangement WorkArrangement?
  employmentType  EmploymentType?
  seniority       SeniorityLevel?
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String           @default("ILS")
  language        LanguageCode?
  skills          String[]
  technologies    String[]
  postedAt        DateTime?
  status          JobStatus        @default(ACTIVE)
  // Deduplication & freshness tracking (populated at ingestion).
  // dedupeKey groups the same posting seen across multiple sources;
  // contentHash detects changes to a posting's content. When a posting is a
  // cross-source duplicate its status is DUPLICATE and canonicalId points at
  // the kept (canonical) job.
  dedupeKey       String?
  contentHash     String?
  canonicalId     String?          @db.Uuid
  qualityScore    Int?
  firstSeenAt     DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  /// Semantic embedding for AI matching (pgvector, cosine similarity). See
  /// CareerProfile.embedding for the same convention.
  embedding Unsupported("vector(1536)")?

  matches JobMatch[]

  @@unique([source, externalId])
  @@index([status])
  @@index([city])
  @@index([dedupeKey])
  @@map("jobs")
}

model JobMatch {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String      @db.Uuid
  job          Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  overallScore Float
  // Per-dimension scores with explanations (experience, skills, technology,
  // industry, culture, growth, salary, location, remote, progression,
  // learning, interview probability, confidence).
  scores       Json
  status       MatchStatus @default(NEW)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([jobId])
  @@map("job_matches")
}

/// Registry of ingestion sources with per-run health. Seeded from the enabled
/// connectors; the source of truth for Discovery and the Admin command center.
model Source {
  id           String           @id @default(uuid()) @db.Uuid
  key          String           @unique
  type         String
  enabled      Boolean          @default(true)
  lastRunAt    DateTime?
  lastStatus   SourceRunStatus?
  lastError    String?
  lastJobCount Int?
  totalRuns    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("sources")
}

/// Companies discovered on public ATS boards. The ATS connectors read their
/// board list from env AND from here, so the Discovery engine can grow coverage
/// automatically without code or config changes.
model Company {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  atsType      String
  atsToken     String
  enabled      Boolean  @default(true)
  origin       String   @default("discovered")
  lastJobCount Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([atsType, atsToken])
  @@index([atsType, enabled])
  @@map("companies")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 hash of the opaque refresh token; the raw value is never stored.
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @db.Uuid
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
