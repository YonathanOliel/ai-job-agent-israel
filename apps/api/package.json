{
  "name": "@ai-job-agent/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API for AI Job Agent Israel.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.716.0",
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.15",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.2.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "mammoth": "1.8.0",
    "node-html-parser": "6.1.13",
    "pdf-parse": "1.1.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.15",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.5",
    "@types/pdf-parse": "1.1.4",
    "@types/supertest": "6.0.2",
    "dotenv-cli": "8.0.0",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "jest": "29.7.0",
    "prisma": "6.2.1",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.1"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
