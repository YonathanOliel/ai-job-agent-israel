# ==========================================================================
# AI Job Agent Israel — Environment variables (example)
# Copy to .env and fill in real values. NEVER commit .env.
# ==========================================================================

# --- Runtime ---
NODE_ENV=development

# --- API (NestJS) ---
API_PORT=4000
API_HOST=0.0.0.0

# --- Web (Next.js) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_job_agent?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- Object storage (S3-compatible) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=il-central-1
STORAGE_BUCKET=resumes
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# --- AI providers (provider abstraction; set only what you use) ---
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Vector database ---
VECTOR_DB_URL=

# --- Email provider ---
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@ai-job-agent.co.il
