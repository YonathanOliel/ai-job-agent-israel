# ==========================================================================
# AI Job Agent Israel — Environment variables (example)
# Copy to .env and fill in real values. NEVER commit .env.
# ==========================================================================

# --- Runtime ---
NODE_ENV=development

# Application owner — the only SUPER_ADMIN with admin-console access.
SUPER_ADMIN_EMAIL=

# --- API (NestJS) ---
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated allowed CORS origins (leave empty in dev to reflect origin)
CORS_ORIGINS=

# --- Web (Next.js) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_job_agent?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- Object storage (S3-compatible) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=il-central-1
STORAGE_BUCKET=resumes
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# --- AI providers (provider abstraction; set only what you use) ---
AI_DEFAULT_PROVIDER=openai
AI_REQUEST_TIMEOUT_MS=30000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Career-profile extraction: "heuristic" (offline, no key) or "llm" (uses AI provider)
PROFILE_EXTRACTOR=heuristic

# --- Job sources ---
# Real jobs with apply links via the public Remotive API (no key required).
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
REMOTIVE_CATEGORY=software-dev
JOB_INGEST_LIMIT=50
# Include the built-in sample jobs alongside real sources (dev/testing only)
ENABLE_SEED_JOBS=false
# Real ISRAELI jobs via Jooble (free key: https://jooble.org/api/about).
# Set JOOBLE_API_KEY to enable Israeli listings automatically.
JOOBLE_API_URL=https://jooble.org/api
JOOBLE_API_KEY=
JOOBLE_LOCATION=Israel
JOOBLE_KEYWORDS=
# Public Telegram job channels (comma-separated usernames, no @). No key needed.
# Only PUBLIC broadcast channels with a t.me/s/ web preview are supported.
# Verified active Israeli hi-tech channels:
#   tech_jobs_il, find_hitech_jobs, ilhotjobs, hitechjobsdatascience
TELEGRAM_CHANNELS=tech_jobs_il,find_hitech_jobs,ilhotjobs,hitechjobsdatascience

# Public ATS job-board APIs (no key). Comma-separated company tokens; each entry
# may be "token" or "token|Display Name". Only Israel-located tech roles are kept.
GREENHOUSE_COMPANIES=catonetworks|Cato Networks,similarweb|Similarweb,payoneer|Payoneer,appsflyer|AppsFlyer,taboola|Taboola,forter|Forter,jfrog|JFrog,fireblocks|Fireblocks,melio|Melio,riskified|Riskified,lightricks|Lightricks,orcasecurity|Orca Security
LEVER_COMPANIES=walkme|WalkMe
ASHBY_COMPANIES=unit|Unit,pinecone|Pinecone,redis|Redis

# Keyed aggregators — each auto-enables once its key is configured.
# How to obtain every key: docs/JOB_SOURCES_API_KEYS.md
# JSearch (Google-for-Jobs via RapidAPI): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
JSEARCH_QUERY=software developer jobs in israel
# Careerjet public API (free affiliate id): https://www.careerjet.com/partners/
CAREERJET_AFFID=
CAREERJET_KEYWORDS=developer
CAREERJET_LOCATION=Israel
# Findwork.dev (free key): https://findwork.dev/developers/
FINDWORK_API_KEY=
FINDWORK_SEARCH=developer

# Elasticsearch full-text search (optional; provided by infra/docker-compose).
# When set, GET /api/jobs?search=... is served by Elasticsearch (relevance +
# fuzzy); otherwise PostgreSQL is used. Safe to leave empty.
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=jobs

# Background ingestion queue (BullMQ on Redis). Set INGEST_CRON to a cron
# expression to ingest every source automatically on that schedule
# (e.g. "*/15 * * * *" = every 15 min). Empty = manual ingestion only.
INGEST_CRON=
INGEST_CONCURRENCY=2
INGEST_JOB_ATTEMPTS=3

# --- Vector database ---
VECTOR_DB_URL=

# --- Email provider ---
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@ai-job-agent.co.il
